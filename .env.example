# Supabase (free tier) — waitlist storage
# Project Settings → API in Supabase dashboard
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Password for /admin (min 16 characters; use a long random string)
# Generate one: openssl rand -base64 32
# Set the same value in Vercel → Project → Settings → Environment Variables
ADMIN_SECRET=change-me-to-a-long-random-secret

# Optional — for launch-day emails (phase 2)
# RESEND_API_KEY=
